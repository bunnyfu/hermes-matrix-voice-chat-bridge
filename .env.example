# LiveKit server (Docker host bridge gateway)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Hermes API Server (inside same container)
HERMES_API_URL=http://127.0.0.1:8642/v1
HERMES_API_KEY=your_hermes_api_key

# Matrix voice bridge device (dedicated device for call E2EE)
MATRIX_HOMESERVER=https://matrix.yourdomain.com
MATRIX_VOICE_ACCESS_TOKEN=your_matrix_voice_access_token
MATRIX_USER_ID=@hermes:yourdomain.com
MATRIX_VOICE_DEVICE_ID=voice-bridge-01
MATRIX_RECOVERY_KEY="xxxx xxxx xxxx xxxx xxxx xxxx xxxx xxxx xxxx xxxx xxxx xxxx"

# Target Matrix room for voice calls
VOICE_BRIDGE_MATRIX_ROOM_ID=!your_room_id:yourdomain.com

# Agent identity in LiveKit — MUST match MatrixRTC membershipID format
AGENT_IDENTITY=@hermes:yourdomain.com:voice-bridge-01
AGENT_NAME=Hermes

# Human users this bridge serves (comma-separated mxids). Rooms are only
# picked up when at least one of these users is a participant — required
# to prevent bridge-vs-bridge room latching. MUST be set or the bridge
# will never join any room.
MATRIX_ALLOWED_USERS=@human:yourdomain.com

# Leave a session if no allowed-human participant remains for this many
# seconds (self-heals accidental latches; 60 by default).
BRIDGE_IDLE_EXIT_SECONDS=60

# Greeting spoken when the agent joins a call (deployment-specific).
BRIDGE_GREETING_TEXT=Hey! How are you?
